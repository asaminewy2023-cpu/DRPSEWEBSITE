{
  "name": "sevp-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently -n cms,web -c blue,green \"pnpm --filter @sevp/cms dev\" \"pnpm --filter @sevp/website dev\"",
    "dev:cms": "pnpm --filter @sevp/cms dev",
    "dev:website": "pnpm --filter @sevp/website dev",
    "build": "pnpm -r --if-present build",
    "build:cms": "pnpm --filter @sevp/cms build",
    "build:website": "pnpm --filter @sevp/website build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "migrate:cms": "pnpm --filter @sevp/cms payload:migrate",
    "migrate:cms:create": "pnpm --filter @sevp/cms payload:migrate:create",
    "types:cms": "pnpm --filter @sevp/cms payload:generate:types",
    "monitor": "bash scripts/monitor.sh",
    "backup": "bash scripts/backup.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.23.1"
  }
}