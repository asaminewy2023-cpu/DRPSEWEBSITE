# Copy to .env and fill in real values before deploying.
POSTGRES_DB=Sevp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
PAYLOAD_SECRET=change-me-long-random-string

# Public URLs
CMS_PUBLIC_BASE_URL=http://localhost:3000
WEBSITE_URL=http://localhost

# Email (contact form notification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@southethiopia.gov.et
EMAIL_FROM_NAME=South Ethiopia Regional State
CONTACT_TO_EMAIL=

# Analytics / Search Console
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# CMS revalidation window (seconds)
CMS_REVALIDATE_SECONDS=60

# On-demand ISR revalidation (must match across cms + website)
REVALIDATE_SECRET=change-me-long-random-string