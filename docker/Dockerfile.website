# syntax=docker/dockerfile:1

# ---- base: install all workspace deps ----
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.18.0 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY patches ./patches
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile --ignore-scripts

# ---- builder: build the website ----
FROM base AS website-builder
WORKDIR /app
ARG NEXT_PUBLIC_CMS_BASE_URL=http://localhost:3000
ARG NEXT_PUBLIC_GA4_ID=
ARG NEXT_PUBLIC_GSC_VERIFICATION=
ENV NEXT_PUBLIC_CMS_BASE_URL=$NEXT_PUBLIC_CMS_BASE_URL
ENV NEXT_PUBLIC_GA4_ID=$NEXT_PUBLIC_GA4_ID
ENV NEXT_PUBLIC_GSC_VERIFICATION=$NEXT_PUBLIC_GSC_VERIFICATION
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @sevp/website build

# ---- website runtime ----
FROM node:22-alpine AS website
RUN corepack enable && corepack prepare pnpm@11.18.0 --activate
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=website-builder /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml ./
COPY --from=website-builder /app/node_modules ./node_modules
COPY --from=website-builder /app/packages ./packages
COPY --from=website-builder /app/apps/website/.next ./apps/website/.next
COPY --from=website-builder /app/apps/website/public ./apps/website/public
COPY --from=website-builder /app/apps/website/package.json ./apps/website/package.json
COPY --from=website-builder /app/apps/website/next.config.ts ./apps/website/next.config.ts
COPY --from=website-builder /app/apps/website/next-env.d.ts ./apps/website/next-env.d.ts
WORKDIR /app/apps/website
EXPOSE 3001
CMD ["pnpm", "start"]